# Sanity CMS (Archive photo galleries)
#
# Both values are safe in the browser and are already the defaults in
# client/src/lib/sanity/env.ts - set them only to point the site at a
# different project or dataset (for example a test dataset).
VITE_SANITY_PROJECT_ID=qkmsxhv6
VITE_SANITY_DATASET=production

# Never put a Sanity API token here. Everything in this file that starts with
# VITE_ is compiled into the public JavaScript bundle.
